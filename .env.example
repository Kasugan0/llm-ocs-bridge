# 服务监听
HOST=127.0.0.1
PORT=8009
DEBUG=false
APP_NAME=llm-ocs-bridge

# 复制为 .env 后执行 chmod 600 .env
# check 成功时会将此令牌写入标准输出中的 OCS 配置
# OCS 访问令牌（必填，仅通过 X-Access-Token 请求头传递）
ACCESS_TOKEN=replace-with-a-random-token

# OpenAI 兼容 LLM 配置（必填）
OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 图片题使用的视觉模型；留空则图片题返回“未配置视觉模型”错误
VISION_MODEL=

# Exa Search（启用 fallback 时可留空，但 check 会警告缺少搜索证据增强）
EXA_API_KEY=
EXA_TIMEOUT_SECONDS=30

# 每个进程最多处理的独立冷题、共享等待者，以及单次答题总预算（秒）
# 超载快速返回 OCS 失败；取消等待者不会取消共享任务，任务仍受总预算约束
MAX_ACTIVE_ANSWERS=8
MAX_ANSWER_WAITERS=64
ANSWER_TIMEOUT_SECONDS=120

# 缓存与检索
CACHE_PATH=bridge.sqlite3
SEARCH_RESULT_LIMIT=

# LLM 输出约束
# 首次调用失败后的最大重试次数；0 表示只调用一次
MAX_LLM_RETRIES=2
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_BACKOFF_SECONDS=0.5
MAX_LLM_OUTPUT_TOKENS=512
MAX_LLM_RESPONSE_BYTES=65536
MAX_EVIDENCE_BYTES=131072
PROMPT_VERSION=v3
SEARCH_CACHE_VERSION=v5
# Exa 不可用或没有有效证据时，默认允许 LLM 直接作答；false 时 Exa 密钥必填
LLM_FALLBACK_ENABLED=true

# 请求与持久化容量
MAX_REQUEST_BYTES=262144
MAX_TITLE_LENGTH=8192
MAX_OPTIONS_COUNT=8
MAX_OPTION_LENGTH=2048
MAX_CACHE_BYTES=1073741824
MAX_ERROR_LOGS=1000
MAX_ERROR_MESSAGE_LENGTH=4096
CACHE_PRUNE_BATCH_SIZE=100
STATS_RECENT_LIMIT=10
SQLITE_BUSY_TIMEOUT_MS=5000

# 搜索结果质量阈值（0.0-1.0，低于该值视为无可用证据）
MIN_SEARCH_QUALITY_SCORE=0.4
